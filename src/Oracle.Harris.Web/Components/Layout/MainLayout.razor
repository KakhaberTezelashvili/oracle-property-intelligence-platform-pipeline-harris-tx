@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 oracle-topbar">
            <span class="oracle-topbar-title">Oracle Property Intelligence Pipeline</span>
            <span class="text-muted small d-none d-md-inline">MCP: <code class="oracle-code">http://localhost:5090/mcp</code></span>
        </div>

        <article class="content px-4 oracle-content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>