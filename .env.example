# Canonical county slug (do not change without updating all maps)
ORACLE_COUNTY_SLUG=harris-tx
ORACLE_COUNTY_FIPS=48201

# DuckDB database file (created on first migration)
DUCKDB_PATH=data/harris-tx/harris-tx.duckdb
DATA_DIR=data
ARTIFACTS_DIR=artifacts
TEMPDATA_ROOT=tempdata

# Filebase / S3-compatible IPFS pinning
S3_ENDPOINT=https://s3.filebase.io
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FILEBASE_OPEN_DATA_BUCKET_HARRIS_TX=elephant-oracle-open-data-harris-tx
FILEBASE_QUERY_TABLE_BUCKET_HARRIS_TX=elephant-oracle-query-table-harris-tx
FILEBASE_OPEN_DATA_IPNS_LABEL=oracle-open-data-harris-tx
FILEBASE_QUERY_TABLE_IPNS_LABEL=oracle-query-table-harris-tx

# MCP (optional remote consumers)
ORACLE_OPEN_DATA_IPNS=
PROPERTY_QUERY_TABLE_MAP={"harris-tx":"https://ipfs.filebase.io/ipns/<network_key>"}
ORACLE_MCP_URL=http://localhost:5090/mcp

# LLM for Web demo chat (Microsoft.Extensions.AI)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Public gateway verification (defaults match README)
IPFS_GATEWAY_1=https://ipfs.io/ipfs/
IPFS_GATEWAY_2=https://dweb.link/ipfs/